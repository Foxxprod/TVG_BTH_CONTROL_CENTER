    "_example": true,
    "_note": "Entree de documentation, ignoree au chargement (voir _example dans buttons_config.py). JSON n'accepte pas les commentaires, elle sert donc de reference listant tous les champs possibles. Seuls section/label/template/layer sont obligatoires, tout le reste est optionnel et retombe sur les defauts du constructeur SceneButton si omis.",
    "section": "prerace | race | postrace (obligatoire)",
    "row": "numero de ligne dans la section, defaut 1",
    "column": "numero de colonne dans la ligne, defaut 1",
    "label": "texte affiche sur le bouton (obligatoire)",
    "template": "nom du template CasparCG a charger (obligatoire)",
    "layer": "numero de layer video CasparCG (obligatoire, entier)",
    "cg_layer": "layer d'empilement CG a l'interieur du layer video, defaut 1",
    "extra_data": {
      "cle_du_champ_template": "valeur fixe toujours envoyee avec ce bouton, defaut aucune"
    },
    "send_ip": "true/false, envoie automatiquement l'ip du serveur de donnees dans field_ip, defaut false",
    "field_ip": "nom du champ template recevant l'ip, defaut 'ip'",
    "bib_on": "true/false, active la boite de dialogue de selection de dossard au premier play, defaut false",
    "field_bib": "nom du champ template recevant le dossard, defaut 'bib'",
    "multipage_on": "true/false, active les fleches de changement de page, defaut false",
    "field_page": "nom du champ template recevant le numero de page, defaut 'page'",
    "reset_page_on_play": "true/false, remet la page a 1 a chaque relance depuis idle, defaut false",
    "target_on": "true/false, active la boite de dialogue de saisie d'une valeur cible (1-30) au premier play, defaut false",
    "field_target": "nom du champ template recevant la valeur cible, defaut 'target'",
    "free_texts": [
      {
        "field": "cle_du_champ_template_1",
